# AgriGuide Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# Do NOT commit your real .env file with private API keys to version control.

# Google Gemini API (Primary Provider)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API (Optional Fallback Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Flask Session Security Key
# Generate a secure random key for production
FLASK_SECRET_KEY=

# Optional: Live Mandi Price API (e-NAM / Agmarknet / Data.gov.in)
# AGMARKNET_API_KEY=